{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://reseller-preparing-notification-smallest.trycloudflare.com/api/:path*" },
    { "source": "/media/:path*", "destination": "https://reseller-preparing-notification-smallest.trycloudflare.com/media/:path*" },
    { "source": "/files/:path*", "destination": "https://reseller-preparing-notification-smallest.trycloudflare.com/files/:path*" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
