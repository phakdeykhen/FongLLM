# FongAI server settings. Copy this file to .env and fill in what you have:
#   cp .env.example .env
# .env is ignored by git, so your keys stay on this computer. Leave a line empty to skip that feature.

# Google sign-in and "Save to Google Drive / Docs / Sheets / Slides"
# From https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# Phone sign-in is ON HOLD (Google only). To turn it back on later: FONGAI_PHONE_LOGIN=1, plus Twilio for real SMS.
FONGAI_PHONE_LOGIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
